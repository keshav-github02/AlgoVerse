# ── Dependencies ──────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ── Build output ──────────────────────────────────────────────────────
dist/
build/
out/
.output/
.vite/
*.tsbuildinfo

# ── Monorepo task cache ───────────────────────────────────────────────
.turbo/

# ── Tooling caches ────────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
*.tgz

# ── Tests & coverage ──────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/
# Merge and patch leftovers. Vitest .snap files themselves stay tracked.
*.orig
*.rej

# ── Environment & secrets ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Logs ──────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Deployment ────────────────────────────────────────────────────────
.wrangler/
.vercel/
.netlify/

# ── Editors ───────────────────────────────────────────────────────────
# Share workspace config, ignore per-developer state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# ── OS cruft ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Generated inspection output ───────────────────────────────────────
demo/

# ── Local working documents ───────────────────────────────────────────
# Internal brief, kept on disk for reference only. The tracked architecture
# record is docs/architecture.md.
AlgoVerse_Architecture_Spec.md

# ── Local scratch ─────────────────────────────────────────────────────
*.local
tmp/
temp/
scratch/
